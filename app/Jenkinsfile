pipeline {
    agent any

    environment {
		APP_NAME = 'demo-cicd'
		DB_HOST = 'mysql'
		DB_NAME = 'labdb'
		DB_USER = "${env.DB_USER}"
		DB_PASSWORD = "${env.DB_PASSWORD}"
		DB_ROOT_PASSWORD = 'labrootpassword'
	}

    parameters {
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run test suite during pipeline')
        choice(name: 'DEPLOY_ENV', choices: ['staging', 'production'], description: 'Target deployment environment')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checking out code from Git..."
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('app') {
                    echo "Building Java application with Maven..."
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            when {
                expression { params.RUN_TESTS == true }
            }
            steps {
                dir('app') {
                    echo "Running tests..."
                    sh 'mvn test || true'
                }
            }
        }

 

stage('Deploy') {
        steps {
            echo "Deploying application via Docker Compose..."
            sh 'docker compose down -v' 
            sh 'docker compose up -d --build app'
            
            echo "Injecting init.sql into the database..."
            // 1. Copy the file from Jenkins into the MySQL container's temporary folder
            sh "docker cp init.sql mysql-lab:/tmp/init.sql"
            
            // 2. Tell MySQL to execute the file from inside the container (no -i or < needed)
            sh "docker exec mysql-lab mysql -uroot -p${env.DB_ROOT_PASSWORD} labdb -e 'source /tmp/init.sql'"
            
            echo "Deployment complete! Application is running at http://localhost:8090"
        }
    }

 }

    post {
        success {
            echo 'Pipeline executed successfully!'
        }
        failure {
            echo 'Pipeline execution failed.'
        }
    }
}