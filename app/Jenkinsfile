pipeline {
    agent any

    environment {
		APP_NAME = 'demo-cicd'
		DB_HOST = 'mysql'
		DB_NAME = 'labdb'
		DB_USER = "${env.DB_USER}"
		DB_PASSWORD = "${env.DB_PASSWORD}"
		DB_ROOT_PASSWORD = 'labrootpassword'
	}

    parameters {
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run test suite during pipeline')
        choice(name: 'DEPLOY_ENV', choices: ['staging', 'production'], description: 'Target deployment environment')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checking out code from Git..."
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('app') {
                    echo "Building Java application with Maven..."
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            when {
                expression { params.RUN_TESTS == true }
            }
            steps {
                dir('app') {
                    echo "Running tests..."
                    sh 'mvn test || true'
                }
            }
        }

 
        
stage('Deploy') {
    steps {
        echo "Deploying to ${params.DEPLOY_ENV}..."

        sh '''
            set -eu

            docker compose up -d --build mysql app

            # Wait for MySQL to become ready
            attempt=0
            until docker compose exec -T mysql \
                mysqladmin ping -h 127.0.0.1 \
                -uroot -p"$DB_ROOT_PASSWORD" --silent
            do
                attempt=$((attempt + 1))
                if [ "$attempt" -ge 30 ]; then
                    echo "MySQL did not become ready."
                    docker compose logs mysql
                    exit 1
                fi
                sleep 2
            done

            # Copy SQL file into the MySQL container
            docker compose cp init.sql mysql:/tmp/init.sql

            # Run init.sql using TCP
            docker compose exec -T mysql sh -c \
                'mysql --protocol=TCP -h 127.0.0.1 \
                -uroot -p"$DB_ROOT_PASSWORD" labdb \
                -e "source /tmp/init.sql"'

            echo "Database initialization completed."
        '''

        echo 'Deployment commands completed.'
    }
}
 }

    post {
        success {
            echo 'Pipeline executed successfully!'
        }
        failure {
            echo 'Pipeline execution failed.'
        }
    }
}