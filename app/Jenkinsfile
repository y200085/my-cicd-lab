
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: 'Run Maven tests before deployment'
        )

        choice(
            name: 'DEPLOY_ENV',
            choices: ['staging', 'production'],
            description: 'Target deployment environment'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out.'
            }
        }

        stage('Validate') {
            steps {
                sh '''
                    set -eu
                    test -f .env
                    test -f docker-compose.yml
                    test -f init.sql
                    test -f app/pom.xml
                    test -f app/Dockerfile

                    docker --version
                    docker compose version
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                dir('app') {
                    sh 'mvn -B clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            when {
                expression { params.RUN_TESTS }
            }
            steps {
                dir('app') {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    junit testResults: 'app/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    if (params.DEPLOY_ENV == 'production') {
                        error(
                            'Production deployment is disabled. Configure a separate production target and credentials first.'
                        )
                    }
                }

                echo 'Deploying staging environment...'

                sh '''
                    set -eu

                    # Load existing credentials from .env.
                    set -a
                    . ./.env
                    set +a

                    : "${DB_ROOT_PASSWORD:?DB_ROOT_PASSWORD is required}"
                    : "${DB_NAME:?DB_NAME is required}"

                    # Start/update services without deleting database volumes.
                    docker compose up -d --build mysql app

                    # Wait for MySQL to be ready.
                    attempt=0
                    until docker compose exec -T \
                        -e MYSQL_PWD="$DB_ROOT_PASSWORD" \
                        mysql mysqladmin ping \
                        -h 127.0.0.1 -uroot --silent
                    do
                        attempt=$((attempt + 1))
                        if [ "$attempt" -ge 30 ]; then
                            echo "MySQL failed to become ready."
                            docker compose logs mysql
                            exit 1
                        fi
                        sleep 2
                    done

                    # Copy SQL into the MySQL container.
                    docker compose cp init.sql mysql:/tmp/init.sql

                    # Execute initialization script using TCP.
                    docker compose exec -T \
                        -e MYSQL_PWD="$DB_ROOT_PASSWORD" \
                        mysql mysql \
                        --protocol=TCP \
                        -h 127.0.0.1 \
                        -uroot \
                        "$DB_NAME" \
                        -e "source /tmp/init.sql"

                    echo "Database initialization completed."

                    # Verify the app through Docker Desktop's published port.
                    attempt=0
                    until curl --fail --silent \
                        http://host.docker.internal:8090/ >/dev/null
                    do
                        attempt=$((attempt + 1))
                        if [ "$attempt" -ge 15 ]; then
                            echo "Application health check failed."
                            docker compose logs app
                            exit 1
                        fi
                        sleep 2
                    done

                    echo "Staging deployment and smoke check passed."
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully!'
        }
        failure {
            echo 'Pipeline execution failed. Check the stage logs.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}